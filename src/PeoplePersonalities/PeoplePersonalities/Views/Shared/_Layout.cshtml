<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lokalne typy osobowości</title>
    <script type="importmap"></script>
    @* <script type="text/javascript" src="~/js/site.js"></script> *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/documentation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main-view.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/add-person-view.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PeoplePersonalities.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Lokalne typy osobowości
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @Html.IsActive("Home", "Index")"
                                   asp-area="" asp-controller="Home" asp-action="Index">
                                Strona główna
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Html.IsActive("AddPerson", "Index")"
                                   asp-area="" asp-controller="AddPerson" asp-action="Index">
                                Dodaj osobę
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link disabled"
                                   asp-area="" asp-controller="Home" asp-action="Index">
                                Analiza wykresowa
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Html.IsActive("Documentation", "Index")"
                                   asp-area="" asp-controller="Documentation" asp-action="Index">
                                Dokumentacja
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Lokalne typy osobowości | ver: Alpha-0.1.1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Dokumentacja</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
